# Speed IPC schema: navigation v0

schema speed.navigation.v0
version 1

message NavigateRequest {
  sender: Browser
  receiver: Network
  fields:
    request_id: u64
    tab_id: u64
    url: string
    is_top_level: bool
}

message NavigateResponse {
  sender: Network
  receiver: Browser
  fields:
    request_id: u64
    status: enum(allowed, blocked, failed)
    aegis_reason: string
    error_message: string
    document_body: string
}

message CommitDocument {
  sender: Browser
  receiver: Renderer
  fields:
    tab_id: u64
    document_id: u64
    url: string
    document_body: string
}

message CommitErrorPage {
  sender: Browser
  receiver: Renderer
  fields:
    tab_id: u64
    document_id: u64
    url: string
    reason: enum(blocked, failed, crashed)
    message: string
}
