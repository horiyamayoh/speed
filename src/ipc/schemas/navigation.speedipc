# Speed IPC schema: navigation v0

schema speed.navigation.v0
version 1

message NavigateRequest {
  sender: Browser
  receiver: Network
  fields:
    request_id: u64
    tab_id: u64
    url: string
    is_top_level: bool
}

message NavigateResponse {
  sender: Network
  receiver: Browser
  fields:
    request_id: u64
    status: enum(allowed, blocked, failed)
    aegis_reason: string
    error_message: string
    document_body: string
}

message CommitDocument {
  sender: Browser
  receiver: Renderer
  fields:
    tab_id: u64
    document_id: u64
    url: string
    document_body: string
}

message CommitErrorPage {
  sender: Browser
  receiver: Renderer
  fields:
    tab_id: u64
    document_id: u64
    url: string
    reason: enum(blocked, failed, crashed)
    message: string
}

message RenderReady {
  sender: Renderer
  receiver: Browser
  fields:
    tab_id: u64
    document_id: u64
    ok: bool
    is_error_page: bool
    content_height: i32
    error_message: string
    display_commands: list<DisplayCommand>
}

struct DisplayCommand {
  fields:
    type: enum(rect, text, border, image_placeholder)
    x: i32
    y: i32
    width: i32
    height: i32
    color_red: u8
    color_green: u8
    color_blue: u8
    color_alpha: u8
    border_top: i32
    border_right: i32
    border_bottom: i32
    border_left: i32
    font_size_px: i32
    text: string
}
